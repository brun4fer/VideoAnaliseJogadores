generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  seasons      Season[]
  competitions Competition[]
  clubs        Club[]
  players      Player[]
  matches      Match[]
  users        User[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  passwordHash String
  workspaceId  String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@index([workspaceId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Season {
  id           String        @id @default(cuid())
  name         String
  workspaceId  String
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  competitions Competition[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Competition {
  id          String    @id @default(cuid())
  name        String
  seasonId    String
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clubs       Club[]    @relation("CompetitionClubs")
  matches     Match[]

  @@unique([seasonId, name])
  @@index([workspaceId])
  @@index([seasonId])
}

model Club {
  id              String        @id @default(cuid())
  name            String
  shortName       String?
  badgeUrl        String?
  isClientClub    Boolean       @default(false)
  workspaceId     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  competitions    Competition[] @relation("CompetitionClubs")
  players         Player[]
  analyzedMatches Match[]       @relation("AnalyzedClub")
  opponentMatches Match[]       @relation("OpponentClub")

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Player {
  id           String         @id @default(cuid())
  name         String
  shirtNumber  Int?
  photoUrl     String?
  position     String?
  isGoalkeeper Boolean        @default(false)
  active       Boolean        @default(true)
  clubId       String
  workspaceId  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  club         Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions      PlayerAction[]
  matchSquads  MatchSquad[]

  @@index([clubId])
  @@index([workspaceId])
}

model Match {
  id                     String         @id @default(cuid())
  matchDate              DateTime?
  roundName              String?
  venue                  String?
  notes                  String?
  clubId                 String
  opponentClubId         String
  competitionId          String
  workspaceId            String
  firstHalfAttacksRight  Boolean        @default(true)
  firstHalfStartSeconds  Float?
  firstHalfEndSeconds    Float?
  secondHalfStartSeconds Float?
  secondHalfEndSeconds   Float?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  club                   Club           @relation("AnalyzedClub", fields: [clubId], references: [id], onDelete: Restrict)
  opponentClub           Club           @relation("OpponentClub", fields: [opponentClubId], references: [id], onDelete: Restrict)
  competition            Competition    @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  video                  Video?
  playerActions          PlayerAction[]
  squad                  MatchSquad[]

  @@index([workspaceId])
  @@index([clubId])
  @@index([opponentClubId])
  @@index([competitionId])
}

model MatchSquad {
  matchId   String
  playerId  String
  sortOrder Int
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([matchId, playerId])
  @@unique([matchId, sortOrder])
  @@index([playerId])
}

model Video {
  id              String    @id @default(cuid())
  matchId         String    @unique
  fileName        String
  fileSize        BigInt
  durationSeconds Float
  mimeType        String
  lastModified    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  match           Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model PlayerAction {
  id               String            @id @default(cuid())
  matchId          String
  playerId         String
  actionKey        String
  actionName       String
  eventTimeSeconds Float
  startTimeSeconds Float
  endTimeSeconds   Float
  period           Int?
  fieldX           Float?
  fieldY           Float?
  notes            String?
  outcome          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  match            Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player           Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  subActions       PlayerSubAction[]

  @@index([matchId])
  @@index([playerId])
  @@index([actionKey])
}

model PlayerSubAction {
  id               String       @id @default(cuid())
  playerActionId   String
  actionKey        String
  actionName       String
  eventTimeSeconds Float
  fieldX           Float?
  fieldY           Float?
  notes            String?
  outcome          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  playerAction     PlayerAction @relation(fields: [playerActionId], references: [id], onDelete: Cascade)

  @@index([playerActionId])
  @@index([actionKey])
}
